# ============================================================
# НАСТРОЙКИ ПРИЛОЖЕНИЯ  (скопируйте этот файл в файл ".env"
# и заполните значения; главное — ключ авторизации)
# ============================================================

# --- ОБЯЗАТЕЛЬНО ---
# Ключ авторизации GigaChat API (Authorization key).
# Где взять: личный кабинет developers.sber.ru -> проект GigaChat API
# -> "Настройки API" -> кнопка "Получить ключ".
GIGA_AUTH_KEY=

# --- НЕОБЯЗАТЕЛЬНО (можно оставить как есть) ---

# Название модели (для вашего проекта доступны: GigaChat-2, GigaChat-2-Max, GigaChat-2-Pro,
# GigaChat-3-Lightning, GigaChat-3-Pro, GigaChat-3-Ultra — полный список покажет check_setup.py)
GIGA_MODEL=GigaChat-2

# Версия API: GIGACHAT_API_PERS (физлица, по умолчанию), GIGACHAT_API_B2B, GIGACHAT_API_CORP
GIGA_SCOPE=GIGACHAT_API_PERS

# Путь к файлу сертификата "Russian Trusted Root CA" (НУЦ Минцифры), если соединение
# не устанавливается из-за сертификатов. Скачать: https://www.gosuslugi.ru/crt
# В этом проекте готовый набор уже лежит в файле russian_ca_bundle.crt
GIGA_CA_FILE=russian_ca_bundle.crt

# Проверка SSL-сертификатов: 1 — включена (рекомендуется), 0 — отключена (только для локального теста).
# Если ставите 0, оставьте GIGA_CA_FILE пустым.
GIGA_VERIFY_SSL=1

# Порт локального сервера (адрес страницы будет http://127.0.0.1:ПОРТ )
GIGA_PORT=5000

# --- ИНТЕГРАЦИЯ С БИТРИКС24 (необязательно) ---
# Адрес входящего вебхука: Битрикс24 -> Разработчикам -> Входящий вебхук,
# права доступа: только CRM. Пример: https://ваш-портал.bitrix24.ru/rest/1/a1b2c3/
BX_WEBHOOK_URL=
